# Postgres connection. Matches docker-compose.yml's defaults for local
# dev — change the host/credentials for a real deployment.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/card_counting_trainer

# PocketID OIDC. Register a client in your PocketID instance with
# redirect URI: http://localhost:3000/api/auth/callback/pocketid
# (swap the origin for your real domain in production).
POCKETID_ISSUER=https://pocketid.example.com
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=

# Auth.js. Generate a secret with `npx auth secret` or
# `openssl rand -base64 32` — required, used to sign session JWTs.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Set true when running behind a reverse proxy (nginx-proxy-manager) —
# tells Auth.js to trust the proxy's forwarded host/proto headers.
AUTH_TRUST_HOST=true
