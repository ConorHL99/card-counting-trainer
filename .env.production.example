# Production env file for docker-compose.prod.yml. Copy this to `.env`
# in the same directory on the NAS and fill in real values — `.env` is
# gitignored and never baked into the image (see .dockerignore).
#
# This is separate from .env.example (local dev's `npm run dev`
# values) — don't mix the two up.

# --- Dedicated Postgres container (docker-compose.prod.yml's `db`
# service) — pick real credentials, not these placeholders. ---
POSTGRES_USER=card_counting_trainer
POSTGRES_PASSWORD=
POSTGRES_DB=card_counting_trainer

# --- App connection string. Host MUST be "db" (the compose service
# name, resolved over the internal Docker network) and the
# user/password/db MUST match the three values above exactly — this
# is not read by Compose for substitution, it's passed straight into
# the app container as-is. ---
DATABASE_URL=postgres://card_counting_trainer:REPLACE_WITH_SAME_PASSWORD_AS_ABOVE@db:5432/card_counting_trainer

# --- PocketID OIDC. Register a client in your PocketID instance with
# redirect URI: https://<your-real-domain>/api/auth/callback/pocketid ---
POCKETID_ISSUER=https://id.example.com
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=

# --- Auth.js. Generate a secret with `openssl rand -base64 32` —
# required, used to sign session JWTs. AUTH_URL must be the real
# public URL nginx-proxy-manager serves this app on. ---
AUTH_SECRET=
AUTH_URL=https://your-real-domain.example.com
AUTH_TRUST_HOST=true

# --- Host port docker-compose.prod.yml binds the app to (127.0.0.1
# only) — point nginx-proxy-manager's forward config at this port.
# Optional; defaults to 3000 if omitted. ---
APP_PORT=3000
